{
  "name": "mi-ciudad-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "fix:expo": "npx expo install --fix",
    "api:check": "node scripts/verificar-api.mjs",
    "api:iniciar:win": "powershell -ExecutionPolicy Bypass -File scripts/iniciar-api-windows.ps1",
    "api:conectar:win": "powershell -ExecutionPolicy Bypass -File scripts/conectar-app-windows.ps1",
    "api:imagenes": "node scripts/auditar-imagenes.mjs",
    "fotos:externas": "node scripts/auditar-fotos-externas.mjs",
    "fotos:instalar": "node scripts/instalar-fotos-locales.mjs",
    "fotos:reporte": "node scripts/reporte-fotos.mjs",
    "fotos:api:preparar:win": "powershell -ExecutionPolicy Bypass -File scripts/preparar-fotos-api-windows.ps1",
    "entrega:check": "node scripts/verificar-entrega.mjs",
    "api:diagnosticar:win": "powershell -ExecutionPolicy Bypass -File scripts/diagnosticar-backend-windows.ps1",
    "eventos:reprogramar:demo": "node scripts/reprogramar-eventos-demo.mjs",
    "fotos:commons": "node scripts/descargar-fotos-commons.mjs",
    "api:fotos:grupo": "node scripts/diagnosticar-imagenes-grupo.mjs",
    "grupo:conectar": "powershell -ExecutionPolicy Bypass -File scripts/conectar-grupo-remoto-windows.ps1",
    "cierre:lote1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cierre-dos-lotes-windows.ps1 -Lote Fotos",
    "cierre:lote2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cierre-dos-lotes-windows.ps1 -Lote Pruebas",
    "fotos:licencias": "node scripts/verificar-licencias-fotos.mjs",
    "apk:catalogo": "node scripts/verificar-catalogo-apk.mjs",
    "apk:cerrar:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cerrar-apk-26-windows.ps1"
  },
  "dependencies": {
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
